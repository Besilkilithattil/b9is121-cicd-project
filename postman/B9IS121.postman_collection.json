{
  "info": {
    "name": "B9IS121 Azure cloud checks",
    "description": "AI-assisted Postman learning examples. Run against the actual public deployment and retain your own results.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://b9is121-app.victoriouspebble-d3aeb62f.francecentral.azurecontainerapps.io",
      "type": "string"
    },
    {
      "key": "expected_version",
      "value": "1.1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Homepage: status, content and deployed version",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"HTML response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));",
              "pm.test(\"Welcome message\", () => pm.expect(pm.response.text()).to.include(\"Welcome to my project\"));",
              "pm.test(\"Expected deployed version\", () => pm.expect(pm.response.text()).to.include(\"Version \" + pm.collectionVariables.get(\"expected_version\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown page returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/does-not-exist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Homepage rejects POST",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 405\", () => pm.response.to.have.status(405));"
            ]
          }
        }
      ]
    }
  ]
}
